{
  "name": "bynk-playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Bynk in-browser playground. A fully static, client-side app: compile Bynk to JS in wasm, run it in a cross-origin sandboxed iframe + Web Worker. Served at playground.bynk-lang.dev (app) + sandbox.bynk-lang.dev (execution).",
  "scripts": {
    "fetch:assets": "bash scripts/fetch-assets.sh",
    "build": "node build.mjs",
    "serve": "node serve.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "web-tree-sitter": "0.27.1"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/bynk-lang/playground"
  }
}
