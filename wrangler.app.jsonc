// The app origin: the editor + the wasm compiler. A Worker serving
// dist/, reachable at playground.bynk-lang.workers.dev and served at
// playground.bynk-lang.dev. The sandbox is a separate Worker on a separate
// origin (wrangler.sandbox.jsonc); never merge the two (ADR 0140).
//
// worker/app.mjs runs first for /sandbox* (refused: the execution document is served only
// by the sandbox origin, #29) and for /api/*, which it forwards to the share service over
// the SHARE service binding, which ci.yml adds (scripts/with-share-binding.mjs) in a run
// that deployed the share service. Everything else is served straight from dist/.
{
  "name": "playground",
  "compatibility_date": "2026-10-01",
  "main": "./worker/app.mjs",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*", "/sandbox*"] },
  // Creating a snippet writes to KV: at most 10 per minute per client address (worker/app.mjs).
  // namespace_id only has to be unique among this account's rate limits.
  "ratelimits": [{ "name": "SHARE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "workers_dev": true,
  "routes": [{ "pattern": "playground.bynk-lang.dev", "custom_domain": true }]
}
