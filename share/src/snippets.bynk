context snippets

uses ids
consumes bynk { Random }
consumes bynk.cloudflare { Kv }  // locks this unit to Cloudflare

type CreateRequest = {
	source: Source,
}

type CreatedView = {
	id: SnippetId,
}

type SnippetView = {
	source: String,
}

service api from http {
	// Store a snippet under a fresh random id and return the id. A random uuid is
	// cut to an id (`idFromUuid`); the source is bounded by `Source`, so an oversized
	// or empty body is rejected at the boundary before this handler runs. Stored with
	// a retention TTL (`snippetTtlSeconds`, #398) rather than kept forever. An id
	// already in use is never written over: that would replace someone's shared
	// program (#24). The app treats the error as "no short link" and offers the
	// self-contained link instead.
	on POST("/api/snippets") (
		body: CreateRequest
	) -> Effect[HttpResult[CreatedView]] by Visitor given Random, Kv {
		let uuid <- Random.uuid()
		match SnippetId.of(idFromUuid("\(uuid)")) {
			Err(_) => ServerError("could not generate an id"),
			Ok(id) => {
				let existing <- Kv.get(keyOf(id))
				match existing {
					Some(_) => ServerError("could not generate an unused id"),
					None => {
						let _ <- Kv.putTtl(keyOf(id), body.source, snippetTtlSeconds())
						Created(CreatedView { id: id })
					},
				}
			},
		}
	}

	// Fetch a shared snippet by id: `200 OK` with its source, or `404` if the id is
	// unknown. The id is validated against `SnippetId` at the boundary, so a malformed
	// path is a `400` before this handler runs.
	on GET("/api/snippets/:id") (
		id: SnippetId
	) -> Effect[HttpResult[SnippetView]] by Visitor given Kv {
		let stored <- Kv.get(keyOf(id))
		match stored {
			Some(source) => Ok(SnippetView { source: source }),
			None => NotFound,
		}
	}
}
